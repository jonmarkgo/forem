<%= form_with(model: rss_feed) do |form| %>
  <% if rss_feed.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(rss_feed.errors.count, "error") %> prohibited this rss_feed from being saved:</h2>

      <ul>
        <% rss_feed.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :url %>
    <%= form.text_field :url %>
  </div>

  <div class="field">
    <%= form.label :organization_id %>
    <%= form.collection_select :organization_id, current_user.organizations, :id, :name, include_blank: true %>
  </div>

  <div class="field">
    <%= form.label :author_id, "Fallback Author" %>
    <%= form.collection_select :author_id, User.all, :id, :username, include_blank: true %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
